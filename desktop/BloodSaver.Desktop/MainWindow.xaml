<Window x:Class="BloodSaver.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BloodSaver — Desktop"
        Width="1280" Height="820"
        MinWidth="1040" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CanvasBrush}"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,0,5" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FBECEF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#F3D4DC" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SmallLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="CharacterSpacing" Value="500" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True" Margin="18">
                <StackPanel DockPanel.Dock="Top" Margin="0,4,0,28">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="38" Height="38" CornerRadius="12" Background="{StaticResource AccentBrush}">
                            <TextBlock Text="B" Foreground="White" FontSize="22" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="BloodSaver" Foreground="{StaticResource InkBrush}"
                                       FontSize="19" FontWeight="Bold" />
                            <TextBlock Text="DESKTOP" Foreground="{StaticResource MutedBrush}"
                                       FontSize="10" FontWeight="Bold" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,22,0,0">
                    <Border Background="#F7F8FA" BorderBrush="{StaticResource StrokeBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="12">
                        <StackPanel>
                            <TextBlock Text="FOUNDATION BUILD" Style="{StaticResource SmallLabelStyle}" />
                            <TextBlock Text="Backend not connected" Foreground="{StaticResource MutedBrush}"
                                       FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="No live data is displayed in this shell."
                                       Foreground="{StaticResource MutedBrush}" FontSize="11"
                                       Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="V1 • Academic / demo" Foreground="{StaticResource MutedBrush}"
                               FontSize="11" Margin="4,14,0,0" />
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="WORKSPACE" Style="{StaticResource SmallLabelStyle}" Margin="4,0,0,12" />
                    <Button x:Name="DashboardNav" Style="{StaticResource NavButtonStyle}"
                            Click="Dashboard_Click" Background="{StaticResource AccentBrush}"
                            Foreground="White">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▦" Width="27" FontSize="17" />
                            <TextBlock Text="Dashboard" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="SyncNav" Style="{StaticResource NavButtonStyle}" Click="Sync_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="↻" Width="27" FontSize="17" />
                            <TextBlock Text="Sync Center" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="OrganizationsNav" Style="{StaticResource NavButtonStyle}" Click="Organizations_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⌂" Width="27" FontSize="17" />
                            <TextBlock Text="Organizations" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="SettingsNav" Style="{StaticResource NavButtonStyle}" Click="Settings_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙" Width="27" FontSize="17" />
                            <TextBlock Text="Settings" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="72" />
                <RowDefinition Height="*" />
                <RowDefinition Height="34" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,0,1" Padding="28,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="BLOODSAVER WORKSPACE" Style="{StaticResource SmallLabelStyle}" />
                        <TextBlock Text="Windows desktop foundation" Foreground="{StaticResource InkBrush}"
                                   FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0" />
                    </StackPanel>
                    <Border Grid.Column="1" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
                            CornerRadius="20" Padding="12,7" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource WarningBrush}"
                                     VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="NOT CONNECTED" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="34,30,34,36" MaxWidth="1000" HorizontalAlignment="Left">
                    <TextBlock x:Name="PageEyebrow" Text="OVERVIEW" Style="{StaticResource SmallLabelStyle}" />
                    <TextBlock x:Name="PageTitle" Text="Desktop foundation"
                               FontSize="30" FontWeight="Bold" Foreground="{StaticResource InkBrush}"
                               Margin="0,8,0,0" />
                    <TextBlock x:Name="PageDescription"
                               Text="A separate Windows client foundation. Existing web functionality has not been changed."
                               FontSize="14" Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap" MaxWidth="760" Margin="0,10,0,0" />

                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource StrokeBrush}"
                            BorderThickness="1" CornerRadius="16" Padding="24" Margin="0,28,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Background="#FBECEF" CornerRadius="10" Width="38" Height="38">
                                    <TextBlock Text="i" Foreground="{StaticResource AccentBrush}" FontSize="19"
                                               FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="PanelTitle" Text="Foundation only"
                                               FontSize="17" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                                    <TextBlock Text="No backend, login, or sync operation is enabled yet."
                                               Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,0" />
                                </StackPanel>
                            </StackPanel>
                            <Border Height="1" Background="{StaticResource StrokeBrush}" Margin="0,20,0,18" />
                            <TextBlock x:Name="PanelBody"
                                       Text="This milestone establishes the native Windows shell and navigation. Features will be added incrementally after individual checkpoints."
                                       Foreground="{StaticResource InkBrush}" FontSize="14"
                                       TextWrapping="Wrap" MaxWidth="820" />
                            <ItemsControl x:Name="StatusItems" Margin="0,18,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                            <Ellipse Width="6" Height="6" Fill="{StaticResource AccentBrush}"
                                                     VerticalAlignment="Center" Margin="1,0,10,0" />
                                            <TextBlock Text="{Binding}" Foreground="{StaticResource MutedBrush}"
                                                       FontSize="13" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="CURRENT MILESTONE" Style="{StaticResource SmallLabelStyle}" Margin="0,28,0,12" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource StrokeBrush}"
                                BorderThickness="1" CornerRadius="14" Padding="17" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="01 / UI SHELL" Style="{StaticResource SmallLabelStyle}" />
                                <TextBlock Text="In foundation" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{StaticResource InkBrush}" Margin="0,9,0,0" />
                                <TextBlock Text="Native WPF navigation" FontSize="12" Foreground="{StaticResource MutedBrush}"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource StrokeBrush}"
                                BorderThickness="1" CornerRadius="14" Padding="17" Margin="4,0">
                            <StackPanel>
                                <TextBlock Text="02 / BACKEND" Style="{StaticResource SmallLabelStyle}" />
                                <TextBlock Text="Not connected" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{StaticResource InkBrush}" Margin="0,9,0,0" />
                                <TextBlock Text="No live data shown" FontSize="12" Foreground="{StaticResource MutedBrush}"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource StrokeBrush}"
                                BorderThickness="1" CornerRadius="14" Padding="17" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="03 / OFFLINE SYNC" Style="{StaticResource SmallLabelStyle}" />
                                <TextBlock Text="Not implemented" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{StaticResource InkBrush}" Margin="0,9,0,0" />
                                <TextBlock Text="Planned after checkpoints" FontSize="12" Foreground="{StaticResource MutedBrush}"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,1,0,0" Padding="28,0">
                <Grid>
                    <TextBlock Text="BLOODSAVER DESKTOP • FOUNDATION" FontSize="10" FontWeight="Bold"
                               Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="No existing web paths modified" FontSize="10"
                               Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                               HorizontalAlignment="Right" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
